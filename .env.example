# Copia este archivo a ".env" y llena tus datos reales de Telnyx.
# NUNCA subas el archivo ".env" a un repositorio publico ni lo compartas.

# API Key de Telnyx (Portal -> API Keys)
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Connection ID de tu Call Control Application (Portal -> Voice -> Call Control Apps)
TELNYX_CONNECTION_ID=0000000000000000000

# Numero de Telnyx que compraste, en formato E.164 (ej: +5215512345678 o +14155551234)
TELNYX_FROM_NUMBER=+10000000000

# URL publica donde este servidor va a vivir (Telnyx la usa para pedirte instrucciones
# de la llamada y para mandarte eventos). En local con ngrok sera algo como
# https://abcd1234.ngrok-free.app ; ya desplegado en Railway/Render sera la URL
# que ellos te den (ej: https://davvinci-backend.up.railway.app)
PUBLIC_BASE_URL=https://CAMBIA-ESTO.ngrok-free.app

# Puerto local (Railway/Render lo sobreescriben automaticamente)
PORT=3000

# Clave secreta simple que el frontend debe mandar en el header "x-app-key"
# para poder usar /api/dial. Evita que cualquiera que encuentre la URL marque
# a costa tuya. Invéntate algo largo y random.
APP_SECRET=cambia-esto-por-algo-largo-y-dificil
